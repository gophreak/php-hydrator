{
  "name": "gophreak/hydrator",
  "type": "library",
  "description": "A Hydrator for PHP to convert configs, arrays and request objects to objects.",
  "authors": [
    {
      "name": "Raymond Jones"
    }
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Hydrator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "nyholm/psr7": "^1.8"
  }
}
